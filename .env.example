# 通用设置
VITE_VERSION=3.0.2
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=backend
VITE_WITH_CREDENTIALS=true
VITE_OPEN_ROUTE_INFO=false

# 仅用于浏览器本地锁屏数据混淆，不属于服务端秘密。
VITE_LOCK_ENCRYPT_KEY=replace-with-local-ui-key

# 开发代理连接本机 api-server。
VITE_API_URL=/
VITE_API_PROXY_URL=http://127.0.0.1:3000
VITE_AUTH_API_URL=/
VITE_AUTH_API_PROXY_URL=http://127.0.0.1:3000

# 生产环境同域部署使用 /；分域部署改为云端 HTTPS 地址。
# VITE_API_URL=https://api.example.com
# VITE_AUTH_API_URL=https://api.example.com
