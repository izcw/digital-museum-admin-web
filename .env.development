# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 页面通用 API 基础路径，开发环境通过 Vite 代理。
VITE_API_URL = /

# 通用 API 代理地址，统一连接本机 api-server。
VITE_API_PROXY_URL = http://127.0.0.1:3000

# 登录、设备、遥测和 OTA 服务代理地址。
VITE_AUTH_API_PROXY_URL = http://127.0.0.1:3000

# 浏览器请求保持相对路径，由上面的开发代理转发。
VITE_AUTH_API_URL = /

# 是否在构建时删除 console。
VITE_DROP_CONSOLE = false
